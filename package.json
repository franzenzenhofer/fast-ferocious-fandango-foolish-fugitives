{
  "name": "fast-ferocious-fandango-foolish-fugitives",
  "version": "1.0.0",
  "description": "Highway ramming game - rob Geldtransporters, ram cops into barriers, never die",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": ["game", "arcade", "ramming", "typescript"],
  "author": "Franz Enzenhofer",
  "license": "MIT",
  "dependencies": {
    "matter-js": "^0.20.0",
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.19.0",
    "typescript-eslint": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
